START

DISPLAY "E-COMMERCE PLATFORM"

CREATE Array ProductList
CREATE LinkedList Orders

STORE Product Information

DISPLAY "Linear Data Structures"

ACCESS Products Sequentially

SEARCH Product

IF Product Found THEN
    DISPLAY "Product Available"
ELSE
    DISPLAY "Product Not Available"
END IF

DISPLAY "Limitations of Linear Structures"
DISPLAY "Sequential Search Takes More Time"
DISPLAY "Cannot Represent Complex Relationships"

/* Non-Linear Structures */

CREATE Tree ProductCategories
CREATE Graph RecommendationNetwork

ADD Product TO ProductCategories

CONNECT Related Products IN RecommendationNetwork

DISPLAY "Applications"

DISPLAY "Tree -> Product Categories"

DISPLAY "Graph -> Recommendation System"

COMPARE Linear AND Non-Linear Structures

IF Complex Relationship Exists THEN
    USE Non-Linear Structure
ELSE
    USE Linear Structure
END IF

DISPLAY "Processing Completed"

STOP
